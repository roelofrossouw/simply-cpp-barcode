@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/SimplyCppFunctions.cmake")
include(CMakeFindDependencyMacro)

find_or_install_package(sc-core simply-cpp-dev simply-cpp 3.0.0)
